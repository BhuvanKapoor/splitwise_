# Fill this in to save trips to Google Sheets.
# On Streamlit Community Cloud, paste it into the app's Settings → Secrets box.
# Locally, copy this file to .streamlit/secrets.toml (never commit that file).
# Leave it out entirely to use the local SQLite database.

[google_sheets]
# The full URL of your sheet (or just its key, the long id in the URL)
spreadsheet = "https://docs.google.com/spreadsheets/d/YOUR_SHEET_KEY/edit"

# Paste the whole service account JSON key file between the triple quotes, unchanged.
service_account_json = '''
{
  "type": "service_account",
  "project_id": "...",
  "private_key_id": "...",
  "private_key": "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n",
  "client_email": "...@....iam.gserviceaccount.com",
  "...": "..."
}
'''

# Alternatively, instead of service_account_json you can give each field of the key
# in its own section:
# [gcp_service_account]
# type = "service_account"
# project_id = "..."
# private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# client_email = "...@....iam.gserviceaccount.com"
# ...
