# Copy this file to .streamlit/secrets.toml and fill it in to save trips to Google Sheets.
# On Streamlit Community Cloud, paste the same content into App settings → Secrets instead.
# Leave it out entirely to use the local SQLite database.

[google_sheets]
# The full URL of your sheet, or just its key (the long id in the URL)
spreadsheet = "https://docs.google.com/spreadsheets/d/YOUR_SHEET_KEY/edit"

# Paste the fields from your service account's JSON key file here.
[gcp_service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "trip-splitter@your-project-id.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
